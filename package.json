{
  "name": "corn-project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd web && npm run dev",
    "test": "cd server && npm test && cd ../web && npm test",
    "up": "docker compose up -d",
    "down": "docker compose down"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
